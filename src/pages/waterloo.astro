---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import headerImage from '../assets/photos/junco-snow.jpg';
---

<BaseLayout title="Bird Friendly Waterloo — Getting Started">
  <Header slot="header" currentPath="/waterloo" />

  <section class="page-header page-header--photo">
    <div class="page-header__bg">
      <Image src={headerImage} alt="" width={1600} quality={75} />
    </div>
    <div class="page-header__overlay"></div>
    <div class="container">
      <h1>Bird Friendly Waterloo</h1>
      <span class="status status-in-progress">◌ Getting Started</span>
      <span class="photo-credit photo-credit--overlay">Photo: Miriam Bauman</span>
    </div>
  </section>

  <div class="page-content">
    <ScrollReveal>
      <p>
        The City of Waterloo is embarking on its journey toward
        <strong>Bird Friendly City</strong> certification from
        <a href="https://naturecanada.ca/defend-nature/how-you-help-us-take-action/bfc/" target="_blank" rel="noopener">Nature Canada</a>.
      </p>
    </ScrollReveal>

    <ScrollReveal>
      <p>
        As an official subcommittee of
        <a href="https://www.waterlooregionnature.ca" target="_blank" rel="noopener">Waterloo Region Nature</a>,
        we are building a team of community members committed to making Waterloo a safer place for birds.
        We meet regularly and work cooperatively with the City of Waterloo and other community organizations.
      </p>
    </ScrollReveal>

    <ScrollReveal>
      <p>
        Inspired by Kitchener's successful certification in 2024, we are developing an action plan
        to address threats to birds, protect and restore habitats, and engage residents across the city.
      </p>
    </ScrollReveal>

    <ScrollReveal>
      <p>
        <strong>Interested in joining?</strong> We're looking for passionate community members to help
        Waterloo achieve Bird Friendly City status.<br>
      </p>
      <div class="cta-buttons">
        <a href="mailto:birdfriendlywaterloo@gmail.com" class="cta-btn cta-btn--primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Contact Us
        </a>
    <a href="https://www.instagram.com/birdfriendlywaterloo" target="_blank" rel="noopener" class="cta-btn cta-btn--primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-instagram" viewBox="0 0 16 16">
  <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
</svg>
          Follow us on Instagram
        </a>
      </div>

      <a href="/" class="back-link">← Back to home</a>
    </ScrollReveal>
  </div>

  <Footer slot="footer" />
</BaseLayout>
