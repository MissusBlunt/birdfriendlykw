---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityCard from '../components/CityCard.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import heroImage from '../assets/photos/hero-junco-green.jpg';
import ctaImage from '../assets/photos/junco-feeding.jpg';
---

<BaseLayout title="Bird Friendly KW — Making Kitchener-Waterloo Bird Friendly">
  <Header slot="header" currentPath="/" />

  <section class="photo-hero section-divider">
    <div class="photo-hero__img">
      <Image src={heroImage} alt="" width={1600} quality={80} loading="eager" />
    </div>
    <div class="photo-hero__overlay"></div>
    <div class="photo-hero__content">
      <h1>Bird Friendly Kitchener‑Waterloo</h1>
      <p class="subtitle">Making our cities safer for birds — one community at a time.</p>
      <span class="photo-credit photo-credit--overlay">Photo: Miriam Bauman</span>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ScrollReveal>
        <h2>Who We Are</h2>
        <div class="about-text">
          <p>
            We are official subcommittees of
            <a href="https://www.waterlooregionnature.ca" target="_blank" rel="noopener">Waterloo Region Nature</a>,
            dedicated to making Kitchener and Waterloo safer places for birds.
          </p>
          <p>
            We meet regularly and work cooperatively with municipalities, conservation organizations,
            and community groups to reduce threats to birds, protect and restore habitats, and engage
            residents in bird-friendly practices.
          </p>
          <p>
            Kitchener achieved <strong>Bird Friendly City</strong> certification from
            <a href="https://naturecanada.ca/defend-nature/how-you-help-us-take-action/bfc/" target="_blank" rel="noopener">Nature Canada</a>
            in 2024. Waterloo is now embarking on its own certification journey.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ScrollReveal>
        <h2>Our Cities</h2>
      </ScrollReveal>
      <div class="city-cards">
        <ScrollReveal delay={1}>
          <CityCard
            city="Kitchener"
            href="/kitchener"
            status="certified"
            statusLabel="✓ Certified Bird Friendly City"
            description="Certified by Nature Canada in 2024. Working to protect birds through habitat restoration, collision prevention, and community engagement."
          />
        </ScrollReveal>
        <ScrollReveal delay={2}>
          <CityCard
            city="Waterloo"
            href="/waterloo"
            status="in-progress"
            statusLabel="◌ Getting Started"
            description="Embarking on the journey to Bird Friendly City certification. Building a team and developing an action plan."
          />
        </ScrollReveal>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-bg">
      <Image src={ctaImage} alt="" width={1600} quality={75} />
    </div>
    <ScrollReveal class="cta-content">
      <h2>Get Involved</h2>
      <p>
        Whether you're a birder, an educator, a homeowner, or simply someone who cares about
        nature — there's a place for you. Join us in making Kitchener-Waterloo safer for birds.
      </p>
      <div class="cta-buttons">
        <a href="mailto:birdfriendlykitchener@gmail.com" class="cta-btn cta-btn--primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Contact Us
        </a>
        <a href="/calendar" class="cta-btn cta-btn--outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Upcoming Events
        </a>
      </div>
    </ScrollReveal>
    <span class="photo-credit photo-credit--overlay">Photo: Miriam Bauman</span>
  </section>

  <Footer slot="footer" />
</BaseLayout>
