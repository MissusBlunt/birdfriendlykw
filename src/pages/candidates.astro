---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import candidatesData from "../assets/json/candidates.json";
import ScrollReveal from '../components/ScrollReveal.astro';

let candidates = candidatesData;
---

<BaseLayout title="Municipal and Regional Candidates">
  <Header slot="header" currentPath="/candidates" />

  <section class="page-header">
    <div class="container">
      <h1>Municipal and Regional Candidates</h1>
    </div>
  </section>

<div class="page-content">
    <ScrollReveal>
            {candidates.map(c => (
    <p>{c.name} </p>
  ))}
      
    </ScrollReveal>

    <ScrollReveal>
      <p></p>
    </ScrollReveal>

    <ScrollReveal>
      <p></p>
    </ScrollReveal>

    <ScrollReveal>
      <p> </p>

      <a href="/" class="back-link">← Back to home</a>
    </ScrollReveal>
  </div>

  <Footer slot="footer" />
</BaseLayout>
